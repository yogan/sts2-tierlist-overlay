<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>TierListOverlay</AssemblyName>
    <RootNamespace>TierListOverlay</RootNamespace>
    <STS2GameDir Condition="'$(STS2GameDir)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2</STS2GameDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == ''">$(STS2GameDir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</STS2GameDataDir>
    <STS2ModsDir>$(STS2GameDir)/SlayTheSpire2.app/Contents/MacOS/mods/$(AssemblyName)</STS2ModsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/ holds separate projects (e.g. the DevTools mod). -->
    <Compile Remove="tools/**" />
    <Reference Include="sts2">
      <HintPath>$(STS2GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="InstallMod" AfterTargets="Build" Condition="'$(Install)' == 'true'">
    <MakeDir Directories="$(STS2ModsDir)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/TierListOverlay.json" DestinationFolder="$(STS2ModsDir)" />
    <Message Importance="high" Text="Installed to $(STS2ModsDir)" />
  </Target>
</Project>
