<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>DevTools</AssemblyName>
    <RootNamespace>DevTools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(STS2GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="InstallMod" AfterTargets="Build" Condition="'$(Install)' == 'true'">
    <MakeDir Directories="$(STS2ModsDir)/$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/DevTools.json" DestinationFolder="$(STS2ModsDir)/$(AssemblyName)" />
    <Message Importance="high" Text="Installed to $(STS2ModsDir)/$(AssemblyName)" />
  </Target>
</Project>
